# Supabase — from Project Settings → API (https://supabase.com/dashboard)
# Use the publishable (anon) key for NUXT_PUBLIC_SUPABASE_KEY.
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-publishable-key

# Server-only — Nitro routes that bypass RLS (add when needed)
# NUXT_SUPABASE_SECRET_KEY=your-secret-key
